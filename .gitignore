# Local test library built by tools/build_test_library.py.
# ~29 GB of APFS clones -- reproducible from the ES-DE source, never committed.
/library/

# Local credentials and persisted device identity. See config.example.toml.
# The backups too: swapping the RetroAchievements password for a token left a
# `config.toml.bak-*` holding the password in plain text, and `/config.toml`
# alone does not match it. A credential is not safe because the file it usually
# lives in is ignored.
/config.toml
/config.toml.*
/state.json
# What each save state looked like at the last sync — local bookkeeping.
/states-seen.json

# Personal save/state data used as scanner test input — not ours to commit.
/Saves/

# Metadata cache — regenerate with `cargo run -- sync`.
/moose-sdl.toml
/cache.sqlite3
# What the last favourites sync agreed on. Written beside whatever the addon
# was started from, which is this directory when it is run from the checkout.
favorites-baseline.json
/cache.sqlite3-*

