/es_systems.xml
/es_find_rules.xml
/es_settings.xml


# Node / Tauri
node_modules/
dist/
build/
src-tauri/target/
# Generated by tauri-build from tauri.conf.json on every build.
/src-tauri/gen/schemas/

# `gen/android/` is NOT ignored, and that is deliberate.
#
# It starts as generated scaffolding, and stays that way right up until the app
# needs something only the Android project can express — a manifest permission,
# an activity that does more than the template's, an icon. Then it is source,
# and regenerating it silently throws that work away. Two things needed it at
# once: reading the ES-DE folders needs MANAGE_EXTERNAL_STORAGE in the manifest,
# and making the Back button mean "back" needs an activity that asks the page
# before it quits.
#
# It carries its own .gitignore files, which keep out the 1.5 GB of `app/build`,
# the Kotlin wry regenerates under `generated/`, the built `.so`s, and the
# copied tauri.conf.json. What is left is small and is the app.

# macOS
.DS_Store

# Regenerated by tools/make_icon.py on every run.
src-tauri/icons/icon.iconset/
# Likewise, by tools/make_macos_icon.py. Only the .icns it produces is tracked.
src-tauri/icons/macos.iconset/

# Generated RetroArch core options and remaps (regenerated per launch).
/library/retroarch/

# A stray cache the GUI creates when it is run with src-tauri as the working
# directory. Always empty, always regenerated.
/src-tauri/cache.sqlite3

# Loose ROMs dropped in the project root for inspection.
/*.zip
/*.7z
/*.chd

# local safety copies of gamelists/settings before edits
backups/

# Backups of files taken from outside the project. Personal config, not
# ours to publish — kept on disk, out of the history.
backups/

# Inventory of the external game drive. The gzipped manifest and the summary
# are kept, because regenerating them needs the 12 TB drive physically plugged
# in and everything downstream — what is missing, what to fetch, what to copy —
# is answerable without it. The 8.8 MB expanded copy and the derived reports are
# not kept; `gunzip -k` and the tools rebuild them.
/drive-manifest/*
!/drive-manifest/manifest.jsonl.gz
!/drive-manifest/summary.json
!/drive-manifest/README.md

# One-off cleanup script generated for the romM library. Local, not ours to ship.
/moose-rack-remove.sh
/remove-what-claude-added.sh
/remove-your-old-games.sh
/remove-junk.sh
/remove-veronica.sh

# Console firmware images downloaded for the handheld work — hundreds of
# megabytes of somebody else's build, and not ours to redistribute.
/cfw/

# Working lists for media transfers: generated, consumed, and regenerated.
/new-media.txt
/remaining-media.txt
/remaining-arcade.txt

# The dArkOS build system, kept beside the project to read rather than to ship.
# A gigabyte, and a git repository of its own — see docs/handheld-device.md for
# what we take from it. If we ever depend on a pinned revision, make it a
# submodule deliberately rather than letting `git add -A` swallow it.
reference/

# Fonts are a build input, not a source file: pinned by URL and verified by
# hash in assets/fonts/MANIFEST.tsv, fetched by scripts/fetch-fonts.sh. A
# repository is a poor place to keep two megabytes of somebody else's binary.
# The manifest is committed so anybody gets byte-for-byte the same ones.
assets/fonts/*
!assets/fonts/MANIFEST.tsv

# The aarch64 cross toolchain, fetched by scripts/knulli.sh and removable
# with `knulli.sh clean`. Large, and not ours.
.toolchain/
/inventory.db
/inventory.db-wal
/inventory.db-shm
/dats/
/moose-service.toml
