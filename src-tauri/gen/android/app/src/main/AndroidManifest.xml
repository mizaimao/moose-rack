        <!--
          And whatever opens a manual, a video or a link.

          The same Android 11 rule as above, in its other form. A package can be
          named outright when it is known; for "whichever app reads PDFs" the
          declaration is the *intent* instead. Without these
          `resolveActivity` answers null for every one of them — measured:
          `openExternal` reported "nothing on this device opens that" even for
          https://example.com, on a device with a browser.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
