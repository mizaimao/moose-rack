// The building blocks of the current front end, redrawn in Slint: the header's
// buttons, the Sofa/Desk switch, the search box, the cover card and list row,
// the console column's rows, the tab row, chips, a progress bar, a toast, and
// the controls Settings is made of.
import { Theme } from "theme.slint";

export struct GameItem {
    title: string,
    platform: string,
    badge: string,
    year: string,
    size: string,
    tint: color,
    installed: bool,
    favorite: bool,
    cover: image,
    has-cover: bool,
}

export struct PlatformItem {
    name: string,
    short: string,
    count: int,
    tint: color,
}

// A word, and optionally a glyph before it.
export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> primary: false;
    in property <bool> cursor: false;
    callback clicked;

    height: 32px;
    border-radius: Theme.radius;
    background: root.primary ? (touch.has-hover || root.cursor ? Theme.accent.brighter(0.12) : Theme.accent)
        : (touch.has-hover || root.cursor ? Theme.line : Theme.panel-2);
    border-width: root.cursor ? 2px : (root.primary ? 0px : 1px);
    border-color: root.cursor ? Theme.cursor : Theme.line;
    drop-shadow-blur: root.cursor ? 16px : 0px;
    drop-shadow-color: Theme.glow;
    animate background, drop-shadow-blur { duration: Theme.quick; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.primary ? #0e1116 : Theme.text;
                width: 16px;
                height: 16px;
            }
        }
        Text {
            text: root.text;
            color: root.primary ? #0e1116 : Theme.text;
            font-size: 13px;
            font-weight: root.primary ? 700 : 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A glyph alone: Sync, Settings, Random and the rest of the header's right end.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> cursor: false;
    callback clicked;

    width: 32px;
    height: 32px;
    border-radius: Theme.radius;
    background: root.active ? Theme.glass-sel : (touch.has-hover || root.cursor ? Theme.line : transparent);
    border-width: root.cursor ? 2px : 0px;
    border-color: Theme.cursor;
    drop-shadow-blur: root.cursor ? 16px : 0px;
    drop-shadow-color: Theme.glow;
    animate background, drop-shadow-blur { duration: Theme.quick; }

    Image {
        source: root.icon;
        colorize: root.active || root.cursor || touch.has-hover ? Theme.text : Theme.dim;
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Sofa / Desk, and Settings' theme choice.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    in property <bool> cursor: false;
    callback picked(int);

    height: 32px;
    border-radius: Theme.radius;
    background: Theme.panel-2;
    border-width: root.cursor ? 2px : 1px;
    border-color: root.cursor ? Theme.cursor : Theme.line;
    drop-shadow-blur: root.cursor ? 16px : 0px;
    drop-shadow-color: Theme.glow;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in root.options: Rectangle {
            border-radius: Theme.radius - 3px;
            background: i == root.selected ? Theme.glass-sel : (touch.has-hover ? Theme.line : transparent);
            animate background { duration: Theme.quick; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: option;
                    color: i == root.selected ? Theme.text : Theme.dim;
                    font-size: 13px;
                    font-weight: i == root.selected ? 600 : 400;
                    vertical-alignment: center;
                }
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = i;
                    root.picked(i);
                }
            }
        }
    }
}

export component SearchField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> cursor: false;
    out property <bool> focused: input.has-focus;
    callback edited(string);
    callback done();

    public function focus-input() {
        input.focus();
    }

    height: 32px;
    border-radius: Theme.radius;
    background: Theme.panel-2;
    border-width: root.cursor || input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : (root.cursor ? Theme.cursor : Theme.line);
    drop-shadow-blur: root.cursor ? 16px : 0px;
    drop-shadow-color: Theme.glow;
    animate border-color { duration: Theme.quick; }

    Image {
        source: @image-url("../../ui/icons/search.svg");
        colorize: Theme.dim;
        width: 15px;
        height: 15px;
        x: 10px;
        y: (parent.height - self.height) / 2;
    }

    input := TextInput {
        x: 32px;
        width: parent.width - 42px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        color: Theme.text;
        font-size: 13px;
        text <=> root.text;
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.done();
        }
    }

    if root.text == "": Text {
        x: 32px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.dim;
        font-size: 13px;
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Theme.accent : Theme.line;
    animate background { duration: Theme.quick; }

    Rectangle {
        width: 18px;
        height: 18px;
        y: 2px;
        x: root.checked ? root.width - self.width - 2px : 2px;
        border-radius: 9px;
        background: white;
        animate x { duration: 160ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// The header's icon-size slider (90 to 300 px, as #zoom is) and Settings'.
export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;

    property <float> fraction: (root.value - root.minimum) / (root.maximum - root.minimum);

    function set-from(x: length) {
        root.value = root.minimum + Math.max(0, Math.min(1, (x - 8px) / (root.width - 16px))) * (root.maximum - root.minimum);
    }

    height: 20px;
    min-width: 80px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.line;
    }

    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 8px + (parent.width - 16px) * root.fraction;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }

    Rectangle {
        x: (parent.width - self.width) * root.fraction;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000080;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> progress;

    height: 6px;
    border-radius: 3px;
    background: Theme.line;
    clip: true;

    Rectangle {
        x: 0px;
        width: parent.width * Math.max(0, Math.min(1, root.progress));
        height: parent.height;
        border-radius: 3px;
        background: Theme.accent;
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.dim;

    height: 22px;
    border-radius: 11px;
    background: root.tone.with-alpha(0.16);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.45);

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: root.text;
            color: root.tone;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// A key the shoulder buttons stand for, at the ends of the tab row.
export component KeyHint inherits Rectangle {
    in property <string> text;

    width: label.preferred-width + 12px;
    height: 20px;
    border-radius: 5px;
    border-width: 1px;
    border-color: Theme.line;

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: Theme.dim;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    height: 42px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: root.active || touch.has-hover ? Theme.text : Theme.dim;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 10px;
        y: parent.height - 3px;
        width: parent.width - 20px;
        height: 3px;
        border-radius: 1.5px;
        background: root.active ? Theme.accent : transparent;
        animate background { duration: Theme.quick; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A stand-in for box art until real covers come from the server: the platform
// band across the top and the title set large, in a colour of its own.
export component CoverArt inherits Rectangle {
    in property <GameItem> game;
    in property <bool> large: false;

    border-radius: 8px;
    clip: true;
    background: @linear-gradient(160deg, root.game.tint.brighter(0.3) 0%, root.game.tint 45%, root.game.tint.darker(0.55) 100%);

    // The real cover, when the library has one; the stand-in shows through until it loads.
    if root.game.has-cover: Image {
        source: root.game.cover;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }

    Rectangle {
        y: 0px;
        height: root.large ? 26px : 18px;
        background: #00000059;
        Text {
            x: 8px;
            height: parent.height;
            text: root.game.badge;
            color: #ffffffd0;
            font-size: root.large ? 13px : 10px;
            font-weight: 800;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
    }

    if !root.game.has-cover: Text {
        x: 10px;
        y: root.large ? 40px : 28px;
        width: parent.width - 20px;
        text: root.game.title;
        wrap: word-wrap;
        color: white;
        font-size: Math.max(13px, parent.width / 9);
        font-weight: 800;
    }

    if root.game.favorite: Image {
        source: @image-url("../../ui/icons/star.svg");
        colorize: Theme.warn;
        width: root.large ? 20px : 14px;
        height: self.width;
        x: parent.width - self.width - 6px;
        y: root.large ? 3px : 2px;
    }

    if root.game.installed: Rectangle {
        x: parent.width - self.width - 6px;
        y: parent.height - self.height - 6px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: #000000a0;
        Image {
            source: @image-url("../../ui/icons/hard-drive-download.svg");
            colorize: Theme.ok;
            width: 13px;
            height: 13px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

// The grid's card: a glass pane with the art in it, lit up when it is the
// cursor, as .card and .card.sel are in style.css.
export component CoverCard inherits Rectangle {
    in property <GameItem> game;
    in property <bool> selected;
    // The grid has the cursor, so its choice is lit; otherwise the choice is
    // only marked, and the light is wherever the cursor went.
    in property <bool> lit: true;
    callback clicked;
    callback double-clicked;

    property <length> pad: 8px;
    property <bool> cursor: root.selected && root.lit;

    border-radius: Theme.card-radius;
    background: root.cursor ? Theme.glass-sel : (root.selected || touch.has-hover ? Theme.glass-hover : Theme.glass-rest);
    border-width: root.cursor ? 2px : 1px;
    border-color: root.cursor ? Theme.cursor : (root.selected || touch.has-hover ? Theme.glass-edge-hover : Theme.glass-edge);
    drop-shadow-blur: root.cursor ? 22px : (touch.has-hover ? 14px : 0px);
    drop-shadow-color: Theme.glow;
    animate background, border-color, drop-shadow-blur { duration: Theme.quick; }

    art := CoverArt {
        x: root.pad;
        y: root.pad;
        width: root.width - 2 * root.pad;
        height: self.width / 0.75;
        game: root.game;
    }

    Text {
        x: root.pad + 2px;
        y: art.y + art.height + 7px;
        width: root.width - 2 * root.pad - 4px;
        text: root.game.title;
        color: Theme.text;
        font-size: 12px;
        font-weight: 600;
        overflow: elide;
    }

    Text {
        x: root.pad + 2px;
        y: art.y + art.height + 24px;
        width: root.width - 2 * root.pad - 4px;
        text: root.game.year;
        color: Theme.dim;
        font-size: 11px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
    }
}

export component ListRow inherits Rectangle {
    in property <GameItem> game;
    in property <bool> selected;
    in property <bool> lit: true;
    callback clicked;
    callback double-clicked;

    property <bool> cursor: root.selected && root.lit;

    border-radius: Theme.radius;
    background: root.cursor ? Theme.glass-sel : (root.selected || touch.has-hover ? Theme.glass-hover : Theme.glass-rest);
    border-width: root.cursor ? 2px : 1px;
    border-color: root.cursor ? Theme.cursor : Theme.glass-edge;
    drop-shadow-blur: root.cursor ? 16px : 0px;
    drop-shadow-color: Theme.glow;
    animate background, border-color { duration: Theme.quick; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 12px;
        Rectangle {
            width: 24px;
            border-radius: 4px;
            background: @linear-gradient(160deg, root.game.tint.brighter(0.3) 0%, root.game.tint.darker(0.5) 100%);
        }
        Text {
            text: root.game.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.game.favorite: VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../ui/icons/star.svg");
                colorize: Theme.warn;
                width: 14px;
                height: 14px;
            }
        }
        Text {
            width: 130px;
            text: root.game.platform;
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 40px;
            text: root.game.year;
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            width: 60px;
            text: root.game.size;
            color: Theme.dim;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.game.installed ? Theme.ok : Theme.line;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
    }
}

// A row in the console column of the Desk layout.
export component ConsoleRow inherits Rectangle {
    in property <PlatformItem> item;
    in property <bool> selected;
    in property <bool> cursor: false;
    callback clicked;

    height: 40px;
    border-radius: Theme.radius;
    background: root.selected ? Theme.glass-sel : (touch.has-hover ? Theme.glass-hover : transparent);
    border-width: root.cursor ? 2px : 0px;
    border-color: Theme.cursor;
    drop-shadow-blur: root.cursor ? 16px : 0px;
    drop-shadow-color: Theme.glow;
    animate background, drop-shadow-blur { duration: Theme.quick; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 24px;
                border-radius: 6px;
                background: root.item.tint;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.item.short;
                    color: white;
                    font-size: 9px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.item.name;
            color: root.selected ? Theme.text : Theme.text.darker(0.08);
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: "\{root.item.count}";
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> shown;

    width: label.preferred-width + 36px;
    height: 40px;
    border-radius: 20px;
    background: #2b3039f2;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000080;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: 180ms; }

    label := Text {
        x: 18px;
        height: parent.height;
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
    }
}

// One button on the connected pad, drawn the way it is printed: a letter, or
// PlayStation's four shapes in their colours, or a key name for the keyboard.
export component PadGlyph inherits Rectangle {
    in property <string> label;

    property <bool> shape: root.label == "cross" || root.label == "circle" || root.label == "square" || root.label == "triangle";

    width: root.shape ? 24px : Math.max(24px, text.preferred-width + 12px);
    height: 24px;
    border-radius: 12px;
    background: #2a2f38;
    border-width: 1px;
    border-color: Theme.line;

    text := Text {
        visible: !root.shape;
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: Theme.text;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.label == "cross": Path {
        x: 6px;
        y: 6px;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 1.5 1.5 L 10.5 10.5 M 10.5 1.5 L 1.5 10.5";
        stroke: #8db4f0;
        stroke-width: 2px;
    }
    if root.label == "circle": Rectangle {
        x: 6px;
        y: 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        border-width: 2px;
        border-color: #ef7f7f;
    }
    if root.label == "square": Rectangle {
        x: 6.5px;
        y: 6.5px;
        width: 11px;
        height: 11px;
        border-radius: 1.5px;
        border-width: 2px;
        border-color: #e39ad8;
    }
    if root.label == "triangle": Path {
        x: 5px;
        y: 5px;
        width: 14px;
        height: 13px;
        viewbox-width: 14;
        viewbox-height: 13;
        commands: "M 7 1.5 L 12.8 11.5 L 1.2 11.5 Z";
        stroke: #7fdcbc;
        stroke-width: 2px;
    }
}

export component Hint inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> text;

    spacing: 7px;
    VerticalLayout {
        alignment: center;
        PadGlyph {
            label: root.glyph;
        }
    }
    Text {
        text: root.text;
        color: Theme.dim;
        font-size: 12px;
        vertical-alignment: center;
    }
}
