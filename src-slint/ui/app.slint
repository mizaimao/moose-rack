// The window: header, tab row, and either Desk (consoles | games | detail) or
// Sofa (games alone, bigger, with the detail opened over them), as the two
// arrangements in ui/index.html are.
//
// Controller first. One cursor goes everywhere, and where it is lives in two
// properties, `focus-zone` and `focus-index`. Keys and pad buttons go to Rust
// as actions from `moose_rack::binds` and come back as those two properties;
// the mouse sets them too, so mixing the two never leaves two highlights.
import { Theme } from "theme.slint";
import {
    GameItem, PlatformItem, CheckLine, Button, IconButton, Segmented, SearchField, Toggle, Slider,
    ProgressBar, Chip, KeyHint, Tab, CoverArt, CoverCard, ListRow, ConsoleRow, Toast, Hint,
} from "widgets.slint";
import "../../assets/fonts/NotoSans[wdth,wght].ttf";

export { GameItem, PlatformItem, CheckLine }

// Where the cursor can be. Rust uses the same numbers.
export global Zone {
    out property <int> header: 0;
    out property <int> consoles: 1;
    out property <int> grid: 2;
    out property <int> detail: 3;
    out property <int> settings: 4;
    out property <int> sofa: 5;
    out property <int> menu: 6;
    out property <int> keyboard: 7;
}

component GameGrid inherits Rectangle {
    in property <[GameItem]> games;
    // Width over height of the art on show, so the cards take its shape.
    in property <float> art-aspect: 0.75;
    in-out property <int> selected-index;
    in property <length> card-width: 150px;
    in property <bool> list-view;
    in property <bool> lit;
    out property <int> cols: root.list-view ? 1 : Math.max(1, Math.floor((root.width - 2 * root.pad + root.gap) / (root.card-width + root.gap)));
    // Whole rows on screen: what the triggers move by.
    out property <int> page-rows: Math.max(1, Math.floor((root.height - 2 * root.pad + root.gap) / (root.row-height + root.gap)));
    callback picked(int);
    callback play(int);

    property <length> gap: root.list-view ? 6px : 14px;
    property <length> pad: 18px;
    // `card-width` is the smallest a card may be; the cards in a row share out
    // what is left, so the grid always meets the right edge.
    property <length> cell-width: (root.width - 2 * root.pad - (root.cols - 1) * root.gap) / root.cols;
    property <length> card-height: (root.cell-width - 16px) / root.art-aspect + 16px + 40px;
    property <length> row-height: root.list-view ? 44px : root.card-height;
    property <int> rows: Math.ceil(root.games.length / root.cols);
    property <length> sel-top: root.pad + Math.floor(root.selected-index / root.cols) * (root.row-height + root.gap);
    property <length> sel-bottom: root.sel-top + root.row-height;

    // Keep the cursor on screen as it moves, the way the grid scrolls in the
    // current app.
    function ensure-visible() {
        if (root.sel-top < -flick.content-y + root.pad) {
            flick.content-y = -(root.sel-top - root.pad);
        } else if (root.sel-bottom > -flick.content-y + flick.height - root.pad) {
            flick.content-y = -(root.sel-bottom - flick.height + root.pad);
        }
    }

    changed selected-index => {
        root.ensure-visible();
    }

    // The games on screen, as indices into `games`, so covers load only near
    // them: every game in the list has a card, and a cover for each of 2,500
    // arcade games would take gigabytes.
    out property <int> first-visible: Math.max(0, Math.floor((-flick.content-y - root.pad) / (root.row-height + root.gap))) * root.cols;
    out property <int> last-visible: Math.min(root.games.length - 1, (Math.floor((-flick.content-y + flick.height - root.pad) / (root.row-height + root.gap)) + 1) * root.cols - 1);
    callback visible-changed(int, int);
    changed first-visible => {
        root.visible-changed(root.first-visible, root.last-visible);
    }
    changed last-visible => {
        root.visible-changed(root.first-visible, root.last-visible);
    }

    flick := Flickable {
        content-width: self.width;
        content-height: 2 * root.pad + root.rows * (root.row-height + root.gap) - root.gap;
        animate content-y { duration: 160ms; easing: ease-out; }

        for game[i] in root.games: Rectangle {
            x: root.pad + Math.mod(i, root.cols) * (root.cell-width + root.gap);
            y: root.pad + Math.floor(i / root.cols) * (root.row-height + root.gap);
            width: root.cell-width;
            height: root.row-height;

            if !root.list-view: CoverCard {
                game: game;
                art-aspect: root.art-aspect;
                selected: i == root.selected-index;
                lit: root.lit;
                clicked => {
                    root.picked(i);
                }
                double-clicked => {
                    root.play(i);
                }
            }
            if root.list-view: ListRow {
                game: game;
                selected: i == root.selected-index;
                lit: root.lit;
                clicked => {
                    root.picked(i);
                }
                double-clicked => {
                    root.play(i);
                }
            }
        }

        // The cursor: one ring that slides from card to card as it moves, and
        // rides up with the lifted card (rule 9 in docs/controller-ux.md).
        if root.lit && root.games.length > 0: Rectangle {
            x: root.pad + Math.mod(root.selected-index, root.cols) * (root.cell-width + root.gap);
            y: root.pad + Math.floor(root.selected-index / root.cols) * (root.row-height + root.gap) - (root.list-view ? 0px : 6px);
            width: root.cell-width;
            height: root.row-height;
            border-radius: root.list-view ? Theme.radius : Theme.card-radius;
            border-width: 2px;
            border-color: Theme.cursor;
            animate x, y { duration: 120ms; easing: ease-out; }
        }
    }

    if root.games.length == 0: Text {
        width: parent.width;
        height: parent.height;
        text: "Nothing here.";
        color: Theme.dim;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The detail pane: the right column in Desk, the panel over the grid in Sofa.
// `cursor` is which of its three actions has the cursor: Play, the download
// button, the star; -1 for none.
component Detail inherits Rectangle {
    in property <GameItem> game;
    in property <bool> has-game;
    // The game's details from the library (`load_detail` in main.rs): its
    // fuller artwork, description, facts and screenshots. Empty until they load.
    in property <image> art;
    in property <bool> has-art;
    in property <string> summary;
    in property <string> meta;
    in property <string> emulator;
    in property <[image]> shots;
    in property <bool> downloading;
    in property <float> progress;
    in property <length> art-width: 200px;
    in property <int> cursor: -1;
    callback play();
    callback download();
    callback remove();
    callback favorite();

    background: Theme.panel;

    if !root.has-game: Text {
        width: parent.width;
        height: parent.height;
        text: "Pick a game to see it here.";
        color: Theme.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.has-game: VerticalLayout {
        padding: 20px;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            if root.has-art: Image {
                source: root.art;
                width: root.art-width * 1.3;
                height: self.width * self.source.height / Math.max(1, self.source.width);
                image-fit: contain;
            }
            if !root.has-art: CoverArt {
                width: root.art-width;
                height: root.art-width / 0.75;
                game: root.game;
                large: true;
            }
        }

        Text {
            text: root.game.title;
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
            wrap: word-wrap;
        }

        Text {
            text: root.game.platform + (root.game.year != "" ? "  ·  " + root.game.year : "") + (root.game.size != "" ? "  ·  " + root.game.size : "");
            color: Theme.dim;
            font-size: 12px;
        }

        HorizontalLayout {
            alignment: start;
            spacing: 6px;
            if root.game.installed: Chip {
                text: "On this device";
                tone: Theme.ok;
            }
            if !root.game.installed: Chip {
                text: "On the server";
                tone: Theme.dim;
            }
            if root.game.favorite: Chip {
                text: "Favorite";
                tone: Theme.warn;
            }
            if root.emulator != "": Chip {
                text: root.emulator;
                tone: Theme.accent;
            }
        }

        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Button {
                text: "Play";
                primary: true;
                has-icon: true;
                icon: @image-url("../../ui/icons/play.svg");
                cursor: root.cursor == 0;
                clicked => {
                    root.play();
                }
            }
            if !root.game.installed && !root.downloading: Button {
                text: "Take offline";
                has-icon: true;
                icon: @image-url("../../ui/icons/download.svg");
                cursor: root.cursor == 1;
                clicked => {
                    root.download();
                }
            }
            if root.downloading: Button {
                text: "Downloading";
                cursor: root.cursor == 1;
            }
            if root.game.installed: Button {
                text: "Remove";
                cursor: root.cursor == 1;
                clicked => {
                    root.remove();
                }
            }
            IconButton {
                icon: @image-url("../../ui/icons/star.svg");
                active: root.game.favorite;
                cursor: root.cursor == 2;
                clicked => {
                    root.favorite();
                }
            }
        }

        if root.downloading: VerticalLayout {
            spacing: 6px;
            ProgressBar {
                progress: root.progress;
            }
            Text {
                text: "Downloading  " + Math.round(root.progress * 100) + "%";
                color: Theme.dim;
                font-size: 12px;
            }
        }

        if root.meta != "": Text {
            text: root.meta;
            color: Theme.dim;
            font-size: 12px;
            wrap: word-wrap;
        }

        if root.summary != "": Text {
            text: root.summary;
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
            // About eight lines, so the screenshots stay in view.
            height: Math.min(self.preferred-height, 150px);
            overflow: elide;
        }

        if root.shots.length > 0: Text {
            text: "SCREENSHOTS";
            color: Theme.dim;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        if root.shots.length > 0: HorizontalLayout {
            spacing: 8px;
            for shot in root.shots: Image {
                source: shot;
                height: 60px;
                image-fit: contain;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> cursor: false;

    height: 56px;
    border-radius: Theme.radius;
    background: root.cursor ? Theme.glass-hover : transparent;
    border-width: root.cursor ? 2px : 0px;
    border-color: Theme.cursor;
    animate background { duration: Theme.quick; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 14px;
            }
            if root.hint != "": Text {
                text: root.hint;
                color: Theme.dim;
                font-size: 12px;
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

// One key of the on-screen keyboard.
component KeyCap inherits Rectangle {
    in property <string> text;
    in property <bool> cursor: false;
    in property <bool> wide: false;
    callback clicked;

    border-radius: 8px;
    background: root.cursor ? Theme.accent : (touch.has-hover ? Theme.line : Theme.panel-2);
    border-width: root.cursor ? 2px : 1px;
    border-color: root.cursor ? Theme.cursor : Theme.line;
    drop-shadow-blur: root.cursor ? 16px : 0px;
    animate background { duration: Theme.quick; }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: Theme.text;
        font-size: root.wide ? 15px : 20px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One of a question's two answers, side by side.
component AskChoice inherits Rectangle {
    in property <string> label;
    in property <string> sub;
    in property <bool> cursor: false;
    callback clicked;

    height: 72px;
    horizontal-stretch: 1;
    border-radius: 12px;
    background: root.cursor ? Theme.glass-sel : (touch.has-hover ? Theme.glass-hover : Theme.panel-2);
    border-width: root.cursor ? 2px : 1px;
    border-color: root.cursor ? Theme.cursor : Theme.line;
    drop-shadow-blur: root.cursor ? 16px : 0px;
    animate background { duration: Theme.quick; }

    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        alignment: center;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.sub;
            color: Theme.dim;
            font-size: 12px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One row of the Options menu.
component MenuRow inherits Rectangle {
    in property <string> text;
    in property <bool> cursor: false;
    callback clicked;

    height: 46px;
    border-radius: Theme.radius;
    background: root.cursor || touch.has-hover ? Theme.glass-hover : transparent;
    border-width: root.cursor ? 2px : 0px;
    border-color: Theme.cursor;
    animate background { duration: Theme.quick; }

    Text {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.text;
        color: Theme.text;
        font-size: 15px;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {
    title: "Moose Rack (Slint prototype)";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg;
    default-font-family: "Noto Sans";
    default-font-size: 14px;

    in property <[PlatformItem]> platforms;
    in property <[GameItem]> games;
    in property <string> heading: "Platforms";
    // The art shape of the list on show, from `art_aspect` in main.rs.
    in property <float> art-aspect: 0.75;
    in property <string> sort-label: "Name";
    in property <string> status: "Not synced yet";
    in-out property <int> platform-index: 0;
    in-out property <int> selected-index: 0;
    in-out property <int> tab-index: 0;
    // 0 is Sofa, 1 is Desk, in the order the switch draws them.
    in-out property <int> mode: 1;
    in-out property <bool> list-view: false;
    in-out property <float> zoom: 150;
    in-out property <string> query;
    in-out property <int> download-index: -1;
    in-out property <float> download-progress: 0;
    in-out property <bool> settings-open: false;
    in-out property <bool> sofa-detail-open: false;
    // The launch checklist (docs/launch-flow.html): shown when the game or its
    // emulator has something to fetch. `checklist-button` is "" when nothing
    // can be fetched (`checklist-blocked` says why); `checklist-at` is the
    // button under the cursor, 0 the main one and 1 Cancel.
    // The selected game's details, loaded by `load_detail` in main.rs.
    in property <image> detail-art;
    in property <bool> detail-has-art;
    in property <string> detail-summary;
    in property <string> detail-meta;
    in property <string> detail-emulator;
    in property <[image]> detail-shots;
    callback selection-changed(int);
    changed selected-index => {
        root.selection-changed(root.selected-index);
    }
    in-out property <bool> checklist-open: false;

    // A launch that stopped to ask, as Steam does rather than guess: which
    // copy of a save to keep, whether to play while saves can't sync, or
    // with a BIOS missing. Two answers side by side; Back cancels. Rust fills
    // the words and takes the answer through ask-chosen (0, 1, or -1).
    in-out property <bool> ask-open: false;
    in property <string> ask-title;
    in property <string> ask-lead;
    in property <string> ask-detail;
    in property <string> ask-note;
    in property <string> ask-a;
    in property <string> ask-a-sub;
    in property <string> ask-b;
    in property <string> ask-b-sub;
    in-out property <int> ask-at: 0;
    callback ask-chosen(int);
    // The launch checklist or a question is up: only choosing and cancelling
    // work, and the hint bar says just that.
    property <bool> modal: root.ask-open || root.checklist-open;
    in property <string> checklist-game;
    in property <string> checklist-platform;
    in property <[CheckLine]> checklist-lines;
    in property <string> checklist-button;
    in property <string> checklist-blocked;
    in property <string> checklist-progress;
    in-out property <int> checklist-at: 0;
    in-out property <string> toast-text;
    in-out property <bool> toast-shown: false;

    // The cursor. See Zone.
    in-out property <int> focus-zone: Zone.grid;
    in-out property <int> focus-index: 0;
    out property <int> grid-cols: grid.cols;
    out property <int> grid-page-rows: grid.page-rows;

    // Coming back to a pane lands where its cursor last was (rule 2 in
    // docs/controller-ux.md): the header's control, which Rust keeps current
    // (search to begin with), Settings' row, and on closing Settings, wherever
    // the cursor was when it opened.
    in-out property <int> header-at: 1;
    property <int> settings-at: 0;
    property <int> settings-from-zone: Zone.grid;
    property <int> settings-from-index: 0;

    public function open-settings() {
        if (root.settings-open) {
            return;
        }
        root.settings-from-zone = root.focus-zone;
        root.settings-from-index = root.focus-index;
        root.settings-open = true;
        root.focus-zone = Zone.settings;
        root.focus-index = root.settings-at;
    }

    // The Options menu (rule 5): the screen's other actions, on the top face
    // button. Rust fills it for wherever the cursor is; its rows are the menu
    // zone's indices, and closing it puts the cursor back.
    in-out property <bool> menu-open: false;
    in property <string> menu-title;
    in property <[string]> menu-items;
    callback menu-picked(int);
    property <int> menu-from-zone: Zone.grid;
    property <int> menu-from-index: 0;

    public function open-menu() {
        if (root.menu-open || root.settings-open) {
            return;
        }
        root.menu-from-zone = root.focus-zone;
        root.menu-from-index = root.focus-index;
        root.menu-open = true;
        root.focus-zone = Zone.menu;
        root.focus-index = 0;
    }

    public function close-menu() {
        if (!root.menu-open) {
            return;
        }
        root.menu-open = false;
        root.focus-zone = root.menu-from-zone;
        root.focus-index = root.menu-from-index;
    }

    // The on-screen keyboard for search (rule 7), opened in place of the text
    // box while a controller is connected. Its keys are the keyboard zone's
    // indices: 0 to 39 the characters, ten to a row, then Space, Delete, Clear
    // and Done along the bottom (40 to 43). nav.rs moves over them.
    in-out property <bool> osk-open: false;
    out property <[string]> osk-keys: [
        "1", "2", "3", "4", "5", "6", "7", "8", "9", "0",
        "q", "w", "e", "r", "t", "y", "u", "i", "o", "p",
        "a", "s", "d", "f", "g", "h", "j", "k", "l", "'",
        "z", "x", "c", "v", "b", "n", "m", "-", ":", "&"
    ];
    callback osk-pressed(int);

    // Leaving by Done, the last row (5), opens Settings at the top next time.
    public function close-settings() {
        if (!root.settings-open) {
            return;
        }
        root.settings-at = root.focus-zone == Zone.settings && root.focus-index < 5 ? root.focus-index : 0;
        root.settings-open = false;
        root.focus-zone = root.settings-from-zone;
        root.focus-index = root.settings-from-index;
    }

    // The controller in hand, as SDL describes it, or the keyboard's keys when
    // there is none. Each glyph is the button that does that job on this pad.
    in property <bool> pad-connected: false;
    in property <string> pad-name;
    in property <string> pad-kind;
    in property <string> glyph-confirm: "Enter";
    in property <string> glyph-back: "Esc";
    in property <string> glyph-left: "F";
    in property <string> glyph-top: "S";
    in property <string> shoulder-left: "Q";
    in property <string> shoulder-right: "E";
    in property <string> start-label: "O";

    // Settings' sample controls. They change nothing yet but their own state.
    in-out property <bool> opt-autosync: true;
    in-out property <bool> opt-hidden: false;
    in-out property <bool> opt-sounds: true;
    in-out property <int> opt-theme: 0;

    callback platform-selected(int);
    callback tab-selected(int);
    callback search-edited(string);
    callback random-pick();
    callback sort-toggled();
    callback play(int);
    // The games on screen in the grid, by index: covers load near them.
    callback visible-range(int, int);
    callback checklist-go();
    callback checklist-cancel();
    callback favorite-toggled(int);
    callback download-finished(int);
    callback removed(int);
    // A key, in the names `moose_rack::binds` uses. True when it did something.
    callback key(string) -> bool;

    property <bool> has-current: root.selected-index >= 0 && root.selected-index < root.games.length;
    property <GameItem> current: root.games[root.selected-index];
    property <[string]> tabs: ["Platforms", "Favorites", "On this device"];
    property <bool> downloading-current: root.download-index >= 0 && root.download-index == root.selected-index;

    public function show-toast(text: string) {
        root.toast-text = text;
        root.toast-shown = true;
        toast-timer.running = false;
        toast-timer.running = true;
    }

    public function cycle-tab(step: int) {
        root.tab-index = Math.mod(root.tab-index + step + root.tabs.length, root.tabs.length);
        root.tab-selected(root.tab-index);
    }

    public function start-download() {
        if (root.download-index < 0) {
            root.download-index = root.selected-index;
            root.download-progress = 0;
        }
    }

    public function focus-search() {
        root.focus-zone = Zone.header;
        root.focus-index = 1;
        search.focus-input();
    }

    // Back to the keys after the search box or a click elsewhere.
    public function focus-keys() {
        keys.focus();
    }

    // Slint's key, as the name the bindings know it by.
    pure function key-name(text: string) -> string {
        text == Key.UpArrow ? "ArrowUp"
            : text == Key.DownArrow ? "ArrowDown"
            : text == Key.LeftArrow ? "ArrowLeft"
            : text == Key.RightArrow ? "ArrowRight"
            : text == Key.Return ? "Enter"
            : text == Key.Escape ? "Escape"
            : text == Key.Backspace ? "Backspace"
            : text == Key.Home ? "Home"
            : text == Key.End ? "End"
            : text == Key.PageUp ? "PageUp"
            : text == Key.PageDown ? "PageDown"
            : text == Key.Tab ? "Tab"
            : text
    }

    init => {
        keys.focus();
    }

    toast-timer := Timer {
        interval: 2200ms;
        running: false;
        triggered => {
            root.toast-shown = false;
            self.running = false;
        }
    }

    // A pretend download, so the progress bar has something to show.
    Timer {
        interval: 40ms;
        running: root.download-index >= 0;
        triggered => {
            root.download-progress += 0.012;
            if (root.download-progress >= 1) {
                root.download-finished(root.download-index);
                root.download-index = -1;
                root.download-progress = 0;
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.meta) {
                return reject;
            }
            if (search.focused) {
                // Typing belongs to the box; only leaving it is ours.
                if (event.text == Key.Escape || event.text == Key.DownArrow) {
                    root.focus-zone = Zone.grid;
                    keys.focus();
                    return accept;
                }
                return reject;
            }
            return root.key(root.key-name(event.text)) ? accept : reject;
        }

        VerticalLayout {
            // The header. 52 px as in style.css; the 10 px of padding gives
            // every 32 px control the full height, so nothing needs centring.
            // Its controls are the header zone's indices 0 to 7, left to right.
            Rectangle {
                height: 52px;
                background: Theme.panel;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;

                    if root.mode == 0 && root.sofa-detail-open: Button {
                        text: "Back";
                        has-icon: true;
                        icon: @image-url("../../ui/icons/arrow-left.svg");
                        clicked => {
                            root.sofa-detail-open = false;
                            root.focus-zone = Zone.grid;
                        }
                    }

                    Text {
                        text: root.heading;
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 120px;
                    }

                    Rectangle {
                        width: 6px;
                    }

                    Segmented {
                        options: ["Sofa", "Desk"];
                        selected <=> root.mode;
                        cursor: root.focus-zone == Zone.header && root.focus-index == 0;
                        picked => {
                            root.sofa-detail-open = false;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    search := SearchField {
                        width: 250px;
                        placeholder: "Search all games…";
                        text <=> root.query;
                        cursor: root.focus-zone == Zone.header && root.focus-index == 1;
                        edited(text) => {
                            root.search-edited(text);
                        }
                        done => {
                            root.focus-zone = Zone.grid;
                            keys.focus();
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Slider {
                            width: 100px;
                            minimum: 90;
                            maximum: 300;
                            value <=> root.zoom;
                        }
                    }

                    IconButton {
                        icon: root.list-view ? @image-url("../../ui/icons/list.svg") : @image-url("../../ui/icons/layout-grid.svg");
                        cursor: root.focus-zone == Zone.header && root.focus-index == 2;
                        clicked => {
                            root.list-view = !root.list-view;
                        }
                    }

                    IconButton {
                        icon: @image-url("../../ui/icons/funnel.svg");
                        cursor: root.focus-zone == Zone.header && root.focus-index == 3;
                        clicked => {
                            root.show-toast("Filters are not in the prototype yet");
                        }
                    }

                    IconButton {
                        icon: @image-url("../../ui/icons/dice-5.svg");
                        cursor: root.focus-zone == Zone.header && root.focus-index == 4;
                        clicked => {
                            root.random-pick();
                        }
                    }

                    Button {
                        text: root.sort-label;
                        has-icon: true;
                        icon: @image-url("../../ui/icons/arrow-down-narrow-wide.svg");
                        cursor: root.focus-zone == Zone.header && root.focus-index == 5;
                        clicked => {
                            root.sort-toggled();
                        }
                    }

                    IconButton {
                        icon: @image-url("../../ui/icons/refresh-cw.svg");
                        cursor: root.focus-zone == Zone.header && root.focus-index == 6;
                        clicked => {
                            root.show-toast("Saves synced (pretend)");
                        }
                    }

                    IconButton {
                        icon: @image-url("../../ui/icons/settings.svg");
                        active: root.settings-open;
                        cursor: root.focus-zone == Zone.header && root.focus-index == 7;
                        clicked => {
                            root.open-settings();
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
            }

            // The tab row. The shoulder buttons move along it, so it never
            // takes the cursor itself.
            Rectangle {
                height: 42px;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 16px;
                    spacing: 2px;

                    VerticalLayout {
                        alignment: center;
                        KeyHint {
                            text: root.shoulder-left;
                        }
                    }

                    for tab[i] in root.tabs: Tab {
                        text: tab;
                        active: i == root.tab-index;
                        clicked => {
                            root.tab-index = i;
                            root.tab-selected(i);
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        KeyHint {
                            text: root.shoulder-right;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: root.games.length + " games  ·  " + root.status;
                        color: Theme.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;

                if root.mode == 1: Rectangle {
                    width: 230px;
                    background: Theme.panel;

                    Text {
                        x: 18px;
                        y: 14px;
                        text: "CONSOLES";
                        color: Theme.dim;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 1px;
                    }

                    Flickable {
                        y: 36px;
                        height: parent.height - 36px;
                        content-height: root.platforms.length * 42px + 12px;

                        for platform[i] in root.platforms: ConsoleRow {
                            x: 8px;
                            y: i * 42px;
                            width: parent.width - 16px;
                            item: platform;
                            selected: root.tab-index == 0 && root.query == "" && i == root.platform-index;
                            cursor: root.focus-zone == Zone.consoles && i == root.platform-index;
                            clicked => {
                                root.platform-index = i;
                                root.platform-selected(i);
                                root.focus-zone = Zone.consoles;
                                keys.focus();
                            }
                        }
                    }

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.line;
                    }
                }

                grid := GameGrid {
                    horizontal-stretch: 1;
                    games: root.games;
                    art-aspect: root.art-aspect;
                    selected-index <=> root.selected-index;
                    card-width: root.mode == 0 ? root.zoom * 1.35 * 1px : root.zoom * 1px;
                    list-view: root.list-view;
                    lit: root.focus-zone == Zone.grid;
                    visible-changed(first, last) => {
                        root.visible-range(first, last);
                    }
                    picked(i) => {
                        root.selected-index = i;
                        root.focus-zone = Zone.grid;
                        keys.focus();
                    }
                    play(i) => {
                        root.play(i);
                    }
                }

                if root.mode == 1: Rectangle {
                    width: 330px;

                    Detail {
                        game: root.current;
                        art: root.detail-art;
                        has-art: root.detail-has-art;
                        summary: root.detail-summary;
                        meta: root.detail-meta;
                        emulator: root.detail-emulator;
                        shots: root.detail-shots;
                        has-game: root.has-current;
                        downloading: root.downloading-current;
                        progress: root.download-progress;
                        cursor: root.focus-zone == Zone.detail ? root.focus-index : -1;
                        play => {
                            root.play(root.selected-index);
                        }
                        download => {
                            root.start-download();
                        }
                        remove => {
                            root.removed(root.selected-index);
                        }
                        favorite => {
                            root.favorite-toggled(root.selected-index);
                        }
                    }

                    Rectangle {
                        width: 1px;
                        x: 0px;
                        background: Theme.line;
                    }
                }
            }

            // What each button does where the cursor is, drawn as the pad in
            // hand prints it.
            Rectangle {
                height: 44px;
                background: Theme.panel;

                Rectangle {
                    y: 0px;
                    height: 1px;
                    background: Theme.line;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 18px;

                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: root.pad-connected ? @image-url("../../ui/icons/gamepad-2.svg") : @image-url("../../ui/icons/monitor.svg");
                                colorize: root.pad-connected ? Theme.ok : Theme.dim;
                                width: 18px;
                                height: 18px;
                            }
                        }
                        Text {
                            text: root.pad-connected ? root.pad-name + "  ·  " + root.pad-kind : "Keyboard  ·  no controller";
                            color: Theme.dim;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 360px;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Hint {
                        glyph: root.glyph-confirm;
                        text: root.ask-open || root.checklist-open ? "Choose"
                            : root.focus-zone == Zone.grid ? (root.mode == 1 ? "Play" : "Open")
                            : root.focus-zone == Zone.consoles ? "Open"
                            : root.focus-zone == Zone.settings ? "Change"
                            : root.focus-zone == Zone.keyboard ? "Type"
                            : "Select";
                    }
                    // Each hint shows only where its button does something
                    // (rule 5 in docs/controller-ux.md); nav.rs matches.
                    // Back does nothing on the grid unless a search is shown.
                    if root.modal || root.focus-zone != Zone.grid || root.query != "": Hint {
                        glyph: root.glyph-back;
                        text: root.modal ? "Cancel"
                            : root.focus-zone == Zone.grid ? "Clear search"
                            : root.focus-zone == Zone.settings || root.focus-zone == Zone.sofa || root.focus-zone == Zone.menu
                                || root.focus-zone == Zone.keyboard ? "Close"
                            : "Back";
                    }
                    // As in Steam's library: X filters, Y sorts, Menu opens
                    // Options. On the keyboard X deletes and Y types a space.
                    if !root.modal && root.focus-zone != Zone.settings && root.focus-zone != Zone.menu: Hint {
                        glyph: root.glyph-left;
                        text: root.focus-zone == Zone.keyboard ? "Delete" : "Filter";
                    }
                    if !root.modal && root.focus-zone != Zone.settings && root.focus-zone != Zone.menu: Hint {
                        glyph: root.glyph-top;
                        text: root.focus-zone == Zone.keyboard ? "Space" : "Sort by";
                    }
                    if !root.modal && root.focus-zone != Zone.settings && root.focus-zone != Zone.menu && root.focus-zone != Zone.keyboard: HorizontalLayout {
                        spacing: 4px;
                        Hint {
                            glyph: root.shoulder-left;
                            text: "";
                        }
                        Hint {
                            glyph: root.shoulder-right;
                            text: "Section";
                        }
                    }
                    if !root.modal && !root.settings-open: Hint {
                        glyph: root.start-label;
                        text: root.focus-zone == Zone.menu ? "Close" : root.focus-zone == Zone.keyboard ? "Done" : "Options";
                    }
                }
            }
        }

        // Sofa: the detail as a panel over the games.
        if root.mode == 0 && root.sofa-detail-open: Rectangle {
            background: #0b0c0fc0;

            TouchArea {
                clicked => {
                    root.sofa-detail-open = false;
                    root.focus-zone = Zone.grid;
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 70px;
                width: 440px;
                height: parent.height - 130px;
                border-radius: 16px;
                clip: true;
                drop-shadow-blur: 40px;
                drop-shadow-color: #00000090;

                TouchArea { }

                Detail {
                    art-width: 240px;
                    game: root.current;
                    art: root.detail-art;
                    has-art: root.detail-has-art;
                    summary: root.detail-summary;
                    meta: root.detail-meta;
                    emulator: root.detail-emulator;
                    shots: root.detail-shots;
                    has-game: root.has-current;
                    downloading: root.downloading-current;
                    progress: root.download-progress;
                    cursor: root.focus-zone == Zone.sofa ? root.focus-index : -1;
                    play => {
                        root.play(root.selected-index);
                    }
                    download => {
                        root.start-download();
                    }
                    remove => {
                        root.removed(root.selected-index);
                    }
                    favorite => {
                        root.favorite-toggled(root.selected-index);
                    }
                }
            }
        }

        // The on-screen keyboard: a panel along the bottom, so the results
        // stay in view above it as they narrow.
        if root.osk-open: Rectangle {
            property <length> key-w: 64px;
            property <length> key-h: 50px;
            property <length> gap: 6px;
            property <length> keys-x: (self.width - 10 * self.key-w - 9 * self.gap) / 2;
            property <length> keys-y: 72px;
            property <length> bottom-y: self.keys-y + 4 * (self.key-h + self.gap);

            // Above the hint bar (44 px), which says what the buttons do here.
            y: parent.height - 44px - self.height;
            height: self.bottom-y + self.key-h + 24px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 30px;
            drop-shadow-color: #00000080;

            TouchArea { }

            Rectangle {
                x: parent.keys-x;
                y: 18px;
                width: 10 * parent.key-w + 9 * parent.gap;
                height: 40px;
                border-radius: 8px;
                background: Theme.panel-2;
                border-width: 1px;
                border-color: Theme.line;

                Text {
                    x: 14px;
                    width: parent.width - 28px;
                    height: parent.height;
                    text: root.query == "" ? "Search all games" : root.query + "|";
                    color: root.query == "" ? Theme.dim : Theme.text;
                    font-size: 18px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            for key[i] in root.osk-keys: KeyCap {
                x: parent.keys-x + Math.mod(i, 10) * (parent.key-w + parent.gap);
                y: parent.keys-y + Math.floor(i / 10) * (parent.key-h + parent.gap);
                width: parent.key-w;
                height: parent.key-h;
                text: key;
                cursor: root.focus-zone == Zone.keyboard && root.focus-index == i;
                clicked => {
                    root.osk-pressed(i);
                }
            }

            // Space, Delete, Clear and Done, over columns 0-3, 4-5, 6-7, 8-9.
            KeyCap {
                x: parent.keys-x;
                y: parent.bottom-y;
                width: 4 * parent.key-w + 3 * parent.gap;
                height: parent.key-h;
                wide: true;
                text: "Space";
                cursor: root.focus-zone == Zone.keyboard && root.focus-index == 40;
                clicked => {
                    root.osk-pressed(40);
                }
            }
            KeyCap {
                x: parent.keys-x + 4 * (parent.key-w + parent.gap);
                y: parent.bottom-y;
                width: 2 * parent.key-w + parent.gap;
                height: parent.key-h;
                wide: true;
                text: "Delete";
                cursor: root.focus-zone == Zone.keyboard && root.focus-index == 41;
                clicked => {
                    root.osk-pressed(41);
                }
            }
            KeyCap {
                x: parent.keys-x + 6 * (parent.key-w + parent.gap);
                y: parent.bottom-y;
                width: 2 * parent.key-w + parent.gap;
                height: parent.key-h;
                wide: true;
                text: "Clear";
                cursor: root.focus-zone == Zone.keyboard && root.focus-index == 42;
                clicked => {
                    root.osk-pressed(42);
                }
            }
            KeyCap {
                x: parent.keys-x + 8 * (parent.key-w + parent.gap);
                y: parent.bottom-y;
                width: 2 * parent.key-w + parent.gap;
                height: parent.key-h;
                wide: true;
                text: "Done";
                cursor: root.focus-zone == Zone.keyboard && root.focus-index == 43;
                clicked => {
                    root.osk-pressed(43);
                }
            }
        }

        // Options: its rows are the menu zone's indices.
        if root.menu-open: Rectangle {
            background: #0b0c0fc0;

            TouchArea {
                clicked => {
                    root.close-menu();
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 420px;
                height: 2 * 20px + 44px + root.menu-items.length * (46px + 2px);
                border-radius: 16px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 40px;
                drop-shadow-color: #00000090;

                TouchArea { }

                VerticalLayout {
                    padding: 20px;
                    spacing: 2px;
                    alignment: start;

                    Text {
                        height: 42px;
                        text: root.menu-title;
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    for item[i] in root.menu-items: MenuRow {
                        text: item;
                        cursor: root.focus-zone == Zone.menu && root.focus-index == i;
                        clicked => {
                            root.menu-picked(i);
                        }
                    }
                }
            }
        }

        // Settings: its rows are the settings zone's indices 0 to 5, Done last.
        if root.settings-open: Rectangle {
            background: #0b0c0fc0;

            TouchArea {
                clicked => {
                    root.close-settings();
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 560px;
                height: 560px;
                border-radius: 16px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 40px;
                drop-shadow-color: #00000090;

                TouchArea { }

                VerticalLayout {
                    padding: 24px;
                    spacing: 2px;

                    HorizontalLayout {
                        height: 40px;
                        Text {
                            text: "Settings";
                            color: Theme.text;
                            font-size: 20px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("../../ui/icons/x.svg");
                                clicked => {
                                    root.close-settings();
                                }
                            }
                        }
                    }

                    SettingRow {
                        label: "Controller";
                        hint: root.pad-connected ? root.pad-name : "None connected; the keyboard drives it";
                        Text {
                            text: root.pad-connected ? root.pad-kind : "";
                            color: Theme.ok;
                            font-size: 13px;
                            font-weight: 600;
                        }
                    }

                    SettingRow {
                        label: "Sync saves automatically";
                        hint: "After a game closes, and when the app starts";
                        cursor: root.focus-zone == Zone.settings && root.focus-index == 0;
                        Toggle {
                            checked <=> root.opt-autosync;
                        }
                    }

                    SettingRow {
                        label: "Show hidden games";
                        cursor: root.focus-zone == Zone.settings && root.focus-index == 1;
                        Toggle {
                            checked <=> root.opt-hidden;
                        }
                    }

                    SettingRow {
                        label: "Menu sounds";
                        cursor: root.focus-zone == Zone.settings && root.focus-index == 2;
                        Toggle {
                            checked <=> root.opt-sounds;
                        }
                    }

                    SettingRow {
                        label: "Theme";
                        cursor: root.focus-zone == Zone.settings && root.focus-index == 3;
                        Segmented {
                            options: ["Dark", "Light", "Auto"];
                            selected <=> root.opt-theme;
                        }
                    }

                    SettingRow {
                        label: "Icon size";
                        hint: Math.round(root.zoom) + " px";
                        cursor: root.focus-zone == Zone.settings && root.focus-index == 4;
                        Slider {
                            width: 180px;
                            minimum: 90;
                            maximum: 300;
                            value <=> root.zoom;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    HorizontalLayout {
                        alignment: end;
                        Button {
                            text: "Done";
                            primary: true;
                            cursor: root.focus-zone == Zone.settings && root.focus-index == 5;
                            clicked => {
                                root.close-settings();
                            }
                        }
                    }
                }
            }
        }

        if root.ask-open: Rectangle {
            background: #0b0c0fc0;

            TouchArea { }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 560px;
                height: ask-box.preferred-height;
                border-radius: 16px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 40px;
                drop-shadow-color: #00000090;

                ask-box := VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    Text {
                        text: root.ask-title;
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.ask-lead;
                        color: Theme.text;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    if root.ask-detail != "": Text {
                        text: root.ask-detail;
                        color: Theme.dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        AskChoice {
                            label: root.ask-a;
                            sub: root.ask-a-sub;
                            cursor: root.ask-at == 0;
                            clicked => {
                                root.ask-chosen(0);
                            }
                        }
                        AskChoice {
                            label: root.ask-b;
                            sub: root.ask-b-sub;
                            cursor: root.ask-at == 1;
                            clicked => {
                                root.ask-chosen(1);
                            }
                        }
                    }
                    if root.ask-note != "": Text {
                        text: root.ask-note;
                        color: Theme.dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        if root.checklist-open: Rectangle {
            background: #0b0c0fc0;

            TouchArea {
                clicked => {
                    root.checklist-cancel();
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 520px;
                height: box.preferred-height;
                border-radius: 16px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 40px;
                drop-shadow-color: #00000090;

                TouchArea { }

                box := VerticalLayout {
                    padding: 24px;
                    spacing: 10px;

                    Text {
                        text: root.checklist-game;
                        color: Theme.text;
                        font-size: 19px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.checklist-platform;
                        color: Theme.dim;
                        font-size: 13px;
                    }

                    for line in root.checklist-lines: HorizontalLayout {
                        spacing: 12px;
                        padding-top: 4px;
                        VerticalLayout {
                            alignment: start;
                            padding-top: 3px;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                border-width: 2px;
                                border-color: line.ready ? Theme.ok : Theme.warn;
                                background: line.ready ? Theme.ok : transparent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text {
                                text: line.title;
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                            }
                            Text {
                                text: line.detail;
                                color: Theme.dim;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                        Text {
                            text: line.size;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                        }
                    }

                    if root.checklist-blocked != "": Text {
                        text: root.checklist-blocked;
                        color: Theme.warn;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.checklist-progress != "" ? root.checklist-progress : "Saves are checked with the server after you press Play.";
                        color: Theme.dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        if root.checklist-button != "" && root.checklist-progress == "": Button {
                            text: root.checklist-button;
                            primary: true;
                            cursor: root.checklist-at == 0;
                            clicked => {
                                root.checklist-go();
                            }
                        }
                        Button {
                            text: "Cancel";
                            cursor: root.checklist-at == 1 || root.checklist-button == "";
                            clicked => {
                                root.checklist-cancel();
                            }
                        }
                    }
                }
            }
        }

        Toast {
            x: (parent.width - self.width) / 2;
            y: root.toast-shown ? parent.height - self.height - 60px : parent.height - self.height - 30px;
            animate y { duration: 220ms; easing: ease-out; }
            text: root.toast-text;
            shown: root.toast-shown;
        }
    }
}
