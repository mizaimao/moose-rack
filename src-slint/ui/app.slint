// The window: header, tab row, and either Desk (consoles | games | detail) or
// Sofa (games alone, bigger, with the detail opened over them), as the two
// arrangements in ui/index.html are.
//
// Controller first. One cursor goes everywhere, and where it is lives in two
// properties, `focus-zone` and `focus-index`. Keys and pad buttons go to Rust
// as actions from `moose_rack::binds` and come back as those two properties;
// the mouse sets them too, so mixing the two never leaves two highlights.
import { Theme } from "theme.slint";
import {
    GameItem, PlatformItem, Button, IconButton, Segmented, SearchField, Toggle, Slider,
    ProgressBar, Chip, KeyHint, Tab, CoverArt, CoverCard, ListRow, ConsoleRow, Toast, Hint,
} from "widgets.slint";
import "../../assets/fonts/NotoSans[wdth,wght].ttf";

export { GameItem, PlatformItem }

// Where the cursor can be. Rust uses the same numbers.
export global Zone {
    out property <int> header: 0;
    out property <int> consoles: 1;
    out property <int> grid: 2;
    out property <int> detail: 3;
    out property <int> settings: 4;
    out property <int> sofa: 5;
}

component GameGrid inherits Rectangle {
    in property <[GameItem]> games;
    in-out property <int> selected-index;
    in property <length> card-width: 150px;
    in property <bool> list-view;
    in property <bool> lit;
    out property <int> cols: root.list-view ? 1 : Math.max(1, Math.floor((root.width - 2 * root.pad + root.gap) / (root.card-width + root.gap)));
    callback picked(int);
    callback play(int);

    property <length> gap: root.list-view ? 6px : 14px;
    property <length> pad: 18px;
    // `card-width` is the smallest a card may be; the cards in a row share out
    // what is left, so the grid always meets the right edge.
    property <length> cell-width: (root.width - 2 * root.pad - (root.cols - 1) * root.gap) / root.cols;
    property <length> card-height: (root.cell-width - 16px) / 0.75 + 16px + 40px;
    property <length> row-height: root.list-view ? 44px : root.card-height;
    property <int> rows: Math.ceil(root.games.length / root.cols);
    property <length> sel-top: root.pad + Math.floor(root.selected-index / root.cols) * (root.row-height + root.gap);
    property <length> sel-bottom: root.sel-top + root.row-height;

    // Keep the cursor on screen as it moves, the way the grid scrolls in the
    // current app.
    function ensure-visible() {
        if (root.sel-top < -flick.content-y + root.pad) {
            flick.content-y = -(root.sel-top - root.pad);
        } else if (root.sel-bottom > -flick.content-y + flick.height - root.pad) {
            flick.content-y = -(root.sel-bottom - flick.height + root.pad);
        }
    }

    changed selected-index => {
        root.ensure-visible();
    }

    flick := Flickable {
        content-width: self.width;
        content-height: 2 * root.pad + root.rows * (root.row-height + root.gap) - root.gap;
        animate content-y { duration: 160ms; easing: ease-out; }

        for game[i] in root.games: Rectangle {
            x: root.pad + Math.mod(i, root.cols) * (root.cell-width + root.gap);
            y: root.pad + Math.floor(i / root.cols) * (root.row-height + root.gap);
            width: root.cell-width;
            height: root.row-height;

            if !root.list-view: CoverCard {
                game: game;
                selected: i == root.selected-index;
                lit: root.lit;
                clicked => {
                    root.picked(i);
                }
                double-clicked => {
                    root.play(i);
                }
            }
            if root.list-view: ListRow {
                game: game;
                selected: i == root.selected-index;
                lit: root.lit;
                clicked => {
                    root.picked(i);
                }
                double-clicked => {
                    root.play(i);
                }
            }
        }
    }

    if root.games.length == 0: Text {
        width: parent.width;
        height: parent.height;
        text: "Nothing here.";
        color: Theme.dim;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The detail pane: the right column in Desk, the panel over the grid in Sofa.
// `cursor` is which of its three actions has the cursor: Play, the download
// button, the star; -1 for none.
component Detail inherits Rectangle {
    in property <GameItem> game;
    in property <bool> has-game;
    in property <bool> downloading;
    in property <float> progress;
    in property <length> art-width: 200px;
    in property <int> cursor: -1;
    callback play();
    callback download();
    callback remove();
    callback favorite();

    background: Theme.panel;

    if !root.has-game: Text {
        width: parent.width;
        height: parent.height;
        text: "Pick a game to see it here.";
        color: Theme.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.has-game: VerticalLayout {
        padding: 20px;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            CoverArt {
                width: root.art-width;
                height: root.art-width / 0.75;
                game: root.game;
                large: true;
            }
        }

        Text {
            text: root.game.title;
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
            wrap: word-wrap;
        }

        Text {
            text: root.game.platform + "  ·  " + root.game.year + "  ·  " + root.game.size;
            color: Theme.dim;
            font-size: 12px;
        }

        HorizontalLayout {
            alignment: start;
            spacing: 6px;
            if root.game.installed: Chip {
                text: "On this device";
                tone: Theme.ok;
            }
            if !root.game.installed: Chip {
                text: "On the server";
                tone: Theme.dim;
            }
            if root.game.favorite: Chip {
                text: "Favorite";
                tone: Theme.warn;
            }
            Chip {
                text: "RetroArch";
                tone: Theme.accent;
            }
        }

        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Button {
                text: "Play";
                primary: true;
                has-icon: true;
                icon: @image-url("../../ui/icons/play.svg");
                cursor: root.cursor == 0;
                clicked => {
                    root.play();
                }
            }
            if !root.game.installed && !root.downloading: Button {
                text: "Take offline";
                has-icon: true;
                icon: @image-url("../../ui/icons/download.svg");
                cursor: root.cursor == 1;
                clicked => {
                    root.download();
                }
            }
            if root.downloading: Button {
                text: "Downloading";
                cursor: root.cursor == 1;
            }
            if root.game.installed: Button {
                text: "Remove";
                cursor: root.cursor == 1;
                clicked => {
                    root.remove();
                }
            }
            IconButton {
                icon: @image-url("../../ui/icons/star.svg");
                active: root.game.favorite;
                cursor: root.cursor == 2;
                clicked => {
                    root.favorite();
                }
            }
        }

        if root.downloading: VerticalLayout {
            spacing: 6px;
            ProgressBar {
                progress: root.progress;
            }
            Text {
                text: "Downloading  " + Math.round(root.progress * 100) + "%";
                color: Theme.dim;
                font-size: 12px;
            }
        }

        Text {
            text: "Box art, screenshots and the description come from the server in the real app. These covers are stand-ins drawn from the title.";
            color: Theme.dim;
            font-size: 12px;
            wrap: word-wrap;
        }

        Text {
            text: "SCREENSHOTS";
            color: Theme.dim;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        HorizontalLayout {
            spacing: 8px;
            for n in 3: Rectangle {
                height: 54px;
                border-radius: 6px;
                background: @linear-gradient(120deg, root.game.tint.darker(0.2 + n * 0.15) 0%, root.game.tint.darker(0.7) 100%);
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> cursor: false;

    height: 56px;
    border-radius: Theme.radius;
    background: root.cursor ? Theme.glass-hover : transparent;
    border-width: root.cursor ? 2px : 0px;
    border-color: Theme.cursor;
    animate background { duration: Theme.quick; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 14px;
            }
            if root.hint != "": Text {
                text: root.hint;
                color: Theme.dim;
                font-size: 12px;
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

export component AppWindow inherits Window {
    title: "Moose Rack (Slint prototype)";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg;
    default-font-family: "Noto Sans";
    default-font-size: 14px;

    in property <[PlatformItem]> platforms;
    in property <[GameItem]> games;
    in property <string> heading: "Platforms";
    in property <string> sort-label: "Name";
    in property <string> status: "Synced 2 min ago";
    in-out property <int> platform-index: 0;
    in-out property <int> selected-index: 0;
    in-out property <int> tab-index: 0;
    // 0 is Sofa, 1 is Desk, in the order the switch draws them.
    in-out property <int> mode: 1;
    in-out property <bool> list-view: false;
    in-out property <float> zoom: 150;
    in-out property <string> query;
    in-out property <int> download-index: -1;
    in-out property <float> download-progress: 0;
    in-out property <bool> settings-open: false;
    in-out property <bool> sofa-detail-open: false;
    in-out property <string> toast-text;
    in-out property <bool> toast-shown: false;

    // The cursor. See Zone.
    in-out property <int> focus-zone: Zone.grid;
    in-out property <int> focus-index: 0;
    out property <int> grid-cols: grid.cols;

    // The controller in hand, as SDL describes it, or the keyboard's keys when
    // there is none. Each glyph is the button that does that job on this pad.
    in property <bool> pad-connected: false;
    in property <string> pad-name;
    in property <string> pad-kind;
    in property <string> glyph-confirm: "Enter";
    in property <string> glyph-back: "Esc";
    in property <string> glyph-favorite: "*";
    in property <string> glyph-search: "/";
    in property <string> shoulder-left: "Q";
    in property <string> shoulder-right: "E";
    in property <string> start-label: ",";

    // Settings' sample controls. They change nothing yet but their own state.
    in-out property <bool> opt-autosync: true;
    in-out property <bool> opt-hidden: false;
    in-out property <bool> opt-sounds: true;
    in-out property <int> opt-theme: 0;

    callback platform-selected(int);
    callback tab-selected(int);
    callback search-edited(string);
    callback random-pick();
    callback sort-toggled();
    callback play(int);
    callback favorite-toggled(int);
    callback download-finished(int);
    callback removed(int);
    // A key, in the names `moose_rack::binds` uses. True when it did something.
    callback key(string) -> bool;

    property <bool> has-current: root.selected-index >= 0 && root.selected-index < root.games.length;
    property <GameItem> current: root.games[root.selected-index];
    property <[string]> tabs: ["Platforms", "Favorites", "On this device"];
    property <bool> downloading-current: root.download-index >= 0 && root.download-index == root.selected-index;

    public function show-toast(text: string) {
        root.toast-text = text;
        root.toast-shown = true;
        toast-timer.running = false;
        toast-timer.running = true;
    }

    public function cycle-tab(step: int) {
        root.tab-index = Math.mod(root.tab-index + step + root.tabs.length, root.tabs.length);
        root.tab-selected(root.tab-index);
    }

    public function start-download() {
        if (root.download-index < 0) {
            root.download-index = root.selected-index;
            root.download-progress = 0;
        }
    }

    public function focus-search() {
        root.focus-zone = Zone.header;
        root.focus-index = 1;
        search.focus-input();
    }

    // Back to the keys after the search box or a click elsewhere.
    public function focus-keys() {
        keys.focus();
    }

    // Slint's key, as the name the bindings know it by.
    pure function key-name(text: string) -> string {
        text == Key.UpArrow ? "ArrowUp"
            : text == Key.DownArrow ? "ArrowDown"
            : text == Key.LeftArrow ? "ArrowLeft"
            : text == Key.RightArrow ? "ArrowRight"
            : text == Key.Return ? "Enter"
            : text == Key.Escape ? "Escape"
            : text == Key.Backspace ? "Backspace"
            : text == Key.Home ? "Home"
            : text == Key.End ? "End"
            : text == Key.PageUp ? "PageUp"
            : text == Key.PageDown ? "PageDown"
            : text == Key.Tab ? "Tab"
            : text
    }

    init => {
        keys.focus();
    }

    toast-timer := Timer {
        interval: 2200ms;
        running: false;
        triggered => {
            root.toast-shown = false;
            self.running = false;
        }
    }

    // A pretend download, so the progress bar has something to show.
    Timer {
        interval: 40ms;
        running: root.download-index >= 0;
        triggered => {
            root.download-progress += 0.012;
            if (root.download-progress >= 1) {
                root.download-finished(root.download-index);
                root.download-index = -1;
                root.download-progress = 0;
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.meta) {
                return reject;
            }
            if (search.focused) {
                // Typing belongs to the box; only leaving it is ours.
                if (event.text == Key.Escape || event.text == Key.DownArrow) {
                    root.focus-zone = Zone.grid;
                    keys.focus();
                    return accept;
                }
                return reject;
            }
            return root.key(root.key-name(event.text)) ? accept : reject;
        }

        VerticalLayout {
            // The header. 52 px as in style.css; the 10 px of padding gives
            // every 32 px control the full height, so nothing needs centring.
            // Its controls are the header zone's indices 0 to 7, left to right.
            Rectangle {
                height: 52px;
                background: Theme.panel;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;

                    if root.mode == 0 && root.sofa-detail-open: Button {
                        text: "Back";
                        has-icon: true;
                        icon: @image-url("../../ui/icons/arrow-left.svg");
                        clicked => {
                            root.sofa-detail-open = false;
                            root.focus-zone = Zone.grid;
                        }
                    }

                    Text {
                        text: root.heading;
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 120px;
                    }

                    Rectangle {
                        width: 6px;
                    }

                    Segmented {
                        options: ["Sofa", "Desk"];
                        selected <=> root.mode;
                        cursor: root.focus-zone == Zone.header && root.focus-index == 0;
                        picked => {
                            root.sofa-detail-open = false;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    search := SearchField {
                        width: 250px;
                        placeholder: "Search all games…";
                        text <=> root.query;
                        cursor: root.focus-zone == Zone.header && root.focus-index == 1;
                        edited(text) => {
                            root.search-edited(text);
                        }
                        done => {
                            root.focus-zone = Zone.grid;
                            keys.focus();
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Slider {
                            width: 100px;
                            minimum: 90;
                            maximum: 300;
                            value <=> root.zoom;
                        }
                    }

                    IconButton {
                        icon: root.list-view ? @image-url("../../ui/icons/list.svg") : @image-url("../../ui/icons/layout-grid.svg");
                        cursor: root.focus-zone == Zone.header && root.focus-index == 2;
                        clicked => {
                            root.list-view = !root.list-view;
                        }
                    }

                    IconButton {
                        icon: @image-url("../../ui/icons/funnel.svg");
                        cursor: root.focus-zone == Zone.header && root.focus-index == 3;
                        clicked => {
                            root.show-toast("Filters are not in the prototype yet");
                        }
                    }

                    IconButton {
                        icon: @image-url("../../ui/icons/dice-5.svg");
                        cursor: root.focus-zone == Zone.header && root.focus-index == 4;
                        clicked => {
                            root.random-pick();
                        }
                    }

                    Button {
                        text: root.sort-label;
                        has-icon: true;
                        icon: @image-url("../../ui/icons/arrow-down-narrow-wide.svg");
                        cursor: root.focus-zone == Zone.header && root.focus-index == 5;
                        clicked => {
                            root.sort-toggled();
                        }
                    }

                    IconButton {
                        icon: @image-url("../../ui/icons/refresh-cw.svg");
                        cursor: root.focus-zone == Zone.header && root.focus-index == 6;
                        clicked => {
                            root.show-toast("Saves synced (pretend)");
                        }
                    }

                    IconButton {
                        icon: @image-url("../../ui/icons/settings.svg");
                        active: root.settings-open;
                        cursor: root.focus-zone == Zone.header && root.focus-index == 7;
                        clicked => {
                            root.settings-open = true;
                            root.focus-zone = Zone.settings;
                            root.focus-index = 0;
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
            }

            // The tab row. The shoulder buttons move along it, so it never
            // takes the cursor itself.
            Rectangle {
                height: 42px;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 16px;
                    spacing: 2px;

                    VerticalLayout {
                        alignment: center;
                        KeyHint {
                            text: root.shoulder-left;
                        }
                    }

                    for tab[i] in root.tabs: Tab {
                        text: tab;
                        active: i == root.tab-index;
                        clicked => {
                            root.tab-index = i;
                            root.tab-selected(i);
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        KeyHint {
                            text: root.shoulder-right;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: root.games.length + " games  ·  " + root.status;
                        color: Theme.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;

                if root.mode == 1: Rectangle {
                    width: 230px;
                    background: Theme.panel;

                    Text {
                        x: 18px;
                        y: 14px;
                        text: "CONSOLES";
                        color: Theme.dim;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 1px;
                    }

                    Flickable {
                        y: 36px;
                        height: parent.height - 36px;
                        content-height: root.platforms.length * 42px + 12px;

                        for platform[i] in root.platforms: ConsoleRow {
                            x: 8px;
                            y: i * 42px;
                            width: parent.width - 16px;
                            item: platform;
                            selected: root.tab-index == 0 && root.query == "" && i == root.platform-index;
                            cursor: root.focus-zone == Zone.consoles && i == root.platform-index;
                            clicked => {
                                root.platform-index = i;
                                root.platform-selected(i);
                                root.focus-zone = Zone.consoles;
                                keys.focus();
                            }
                        }
                    }

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.line;
                    }
                }

                grid := GameGrid {
                    horizontal-stretch: 1;
                    games: root.games;
                    selected-index <=> root.selected-index;
                    card-width: root.mode == 0 ? root.zoom * 1.35 * 1px : root.zoom * 1px;
                    list-view: root.list-view;
                    lit: root.focus-zone == Zone.grid;
                    picked(i) => {
                        root.selected-index = i;
                        root.focus-zone = Zone.grid;
                        keys.focus();
                    }
                    play(i) => {
                        root.play(i);
                    }
                }

                if root.mode == 1: Rectangle {
                    width: 330px;

                    Detail {
                        game: root.current;
                        has-game: root.has-current;
                        downloading: root.downloading-current;
                        progress: root.download-progress;
                        cursor: root.focus-zone == Zone.detail ? root.focus-index : -1;
                        play => {
                            root.play(root.selected-index);
                        }
                        download => {
                            root.start-download();
                        }
                        remove => {
                            root.removed(root.selected-index);
                        }
                        favorite => {
                            root.favorite-toggled(root.selected-index);
                        }
                    }

                    Rectangle {
                        width: 1px;
                        x: 0px;
                        background: Theme.line;
                    }
                }
            }

            // What each button does where the cursor is, drawn as the pad in
            // hand prints it.
            Rectangle {
                height: 44px;
                background: Theme.panel;

                Rectangle {
                    y: 0px;
                    height: 1px;
                    background: Theme.line;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 18px;

                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: root.pad-connected ? @image-url("../../ui/icons/gamepad-2.svg") : @image-url("../../ui/icons/monitor.svg");
                                colorize: root.pad-connected ? Theme.ok : Theme.dim;
                                width: 18px;
                                height: 18px;
                            }
                        }
                        Text {
                            text: root.pad-connected ? root.pad-name + "  ·  " + root.pad-kind : "Keyboard  ·  no controller";
                            color: Theme.dim;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 360px;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Hint {
                        glyph: root.glyph-confirm;
                        text: root.focus-zone == Zone.grid ? (root.mode == 1 ? "Play" : "Open")
                            : root.focus-zone == Zone.consoles ? "Open"
                            : root.focus-zone == Zone.settings ? "Change"
                            : "Select";
                    }
                    Hint {
                        glyph: root.glyph-back;
                        text: root.focus-zone == Zone.settings || root.focus-zone == Zone.sofa ? "Close" : "Back";
                    }
                    if root.focus-zone == Zone.grid || root.focus-zone == Zone.detail || root.focus-zone == Zone.sofa: Hint {
                        glyph: root.glyph-favorite;
                        text: "Favorite";
                    }
                    Hint {
                        glyph: root.glyph-search;
                        text: "Search";
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Hint {
                            glyph: root.shoulder-left;
                            text: "";
                        }
                        Hint {
                            glyph: root.shoulder-right;
                            text: "Section";
                        }
                    }
                    Hint {
                        glyph: root.start-label;
                        text: "Settings";
                    }
                }
            }
        }

        // Sofa: the detail as a panel over the games.
        if root.mode == 0 && root.sofa-detail-open: Rectangle {
            background: #0b0c0fc0;

            TouchArea {
                clicked => {
                    root.sofa-detail-open = false;
                    root.focus-zone = Zone.grid;
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 70px;
                width: 440px;
                height: parent.height - 130px;
                border-radius: 16px;
                clip: true;
                drop-shadow-blur: 40px;
                drop-shadow-color: #00000090;

                TouchArea { }

                Detail {
                    art-width: 240px;
                    game: root.current;
                    has-game: root.has-current;
                    downloading: root.downloading-current;
                    progress: root.download-progress;
                    cursor: root.focus-zone == Zone.sofa ? root.focus-index : -1;
                    play => {
                        root.play(root.selected-index);
                    }
                    download => {
                        root.start-download();
                    }
                    remove => {
                        root.removed(root.selected-index);
                    }
                    favorite => {
                        root.favorite-toggled(root.selected-index);
                    }
                }
            }
        }

        // Settings: its rows are the settings zone's indices 0 to 5, Done last.
        if root.settings-open: Rectangle {
            background: #0b0c0fc0;

            TouchArea {
                clicked => {
                    root.settings-open = false;
                    root.focus-zone = Zone.grid;
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 560px;
                height: 560px;
                border-radius: 16px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 40px;
                drop-shadow-color: #00000090;

                TouchArea { }

                VerticalLayout {
                    padding: 24px;
                    spacing: 2px;

                    HorizontalLayout {
                        height: 40px;
                        Text {
                            text: "Settings";
                            color: Theme.text;
                            font-size: 20px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("../../ui/icons/x.svg");
                                clicked => {
                                    root.settings-open = false;
                                    root.focus-zone = Zone.grid;
                                }
                            }
                        }
                    }

                    SettingRow {
                        label: "Controller";
                        hint: root.pad-connected ? root.pad-name : "None connected; the keyboard drives it";
                        Text {
                            text: root.pad-connected ? root.pad-kind : "";
                            color: Theme.ok;
                            font-size: 13px;
                            font-weight: 600;
                        }
                    }

                    SettingRow {
                        label: "Sync saves automatically";
                        hint: "After a game closes, and when the app starts";
                        cursor: root.focus-zone == Zone.settings && root.focus-index == 0;
                        Toggle {
                            checked <=> root.opt-autosync;
                        }
                    }

                    SettingRow {
                        label: "Show hidden games";
                        cursor: root.focus-zone == Zone.settings && root.focus-index == 1;
                        Toggle {
                            checked <=> root.opt-hidden;
                        }
                    }

                    SettingRow {
                        label: "Menu sounds";
                        cursor: root.focus-zone == Zone.settings && root.focus-index == 2;
                        Toggle {
                            checked <=> root.opt-sounds;
                        }
                    }

                    SettingRow {
                        label: "Theme";
                        cursor: root.focus-zone == Zone.settings && root.focus-index == 3;
                        Segmented {
                            options: ["Dark", "Light", "Auto"];
                            selected <=> root.opt-theme;
                        }
                    }

                    SettingRow {
                        label: "Icon size";
                        hint: Math.round(root.zoom) + " px";
                        cursor: root.focus-zone == Zone.settings && root.focus-index == 4;
                        Slider {
                            width: 180px;
                            minimum: 90;
                            maximum: 300;
                            value <=> root.zoom;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    HorizontalLayout {
                        alignment: end;
                        Button {
                            text: "Done";
                            primary: true;
                            cursor: root.focus-zone == Zone.settings && root.focus-index == 5;
                            clicked => {
                                root.settings-open = false;
                                root.focus-zone = Zone.grid;
                            }
                        }
                    }
                }
            }
        }

        Toast {
            x: (parent.width - self.width) / 2;
            y: root.toast-shown ? parent.height - self.height - 60px : parent.height - self.height - 30px;
            animate y { duration: 220ms; easing: ease-out; }
            text: root.toast-text;
            shown: root.toast-shown;
        }
    }
}
